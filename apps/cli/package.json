{
  "name": "@unkeep/cli",
  "version": "0.1.0",
  "description": "Command-line client for encrypted UnKeep notes and automation workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrettKinny/UnKeep.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/BrettKinny/UnKeep#readme",
  "bugs": {
    "url": "https://github.com/BrettKinny/UnKeep/issues"
  },
  "keywords": [
    "notes",
    "cli",
    "unkeep"
  ],
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.integration.test.*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "unkeep": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unkeep/client": "workspace:^",
    "@unkeep/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@unkeep/server": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
