{
  "name": "unkeep",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @unkeep/web dev",
    "build": "pnpm --filter @unkeep/core build && pnpm --filter @unkeep/web build",
    "preview": "pnpm --filter @unkeep/web preview",
    "check": "pnpm --filter @unkeep/web check",
    "lint": "pnpm --filter @unkeep/web lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
