# Copy to .env only for local development, then fill both values independently
# with output from: openssl rand -base64 32. Configured administrative tokens
# must be 32-256 printable ASCII characters without whitespace.
UNKEEP_SETUP_TOKEN=
UNKEEP_RECOVERY_TOKEN=

# Direct source startup binds to loopback by default. The supplied container
# and Compose configuration explicitly use 0.0.0.0 inside the container while
# publishing only to host loopback.
UNKEEP_HOST=127.0.0.1

# Optional relay storage ceilings. Empty values use the documented safe
# defaults; lower them only after measuring the current encrypted vault.
UNKEEP_MAX_ENCRYPTED_RECORD_BYTES=
UNKEEP_MAX_RECORDS=
UNKEEP_MAX_ATTACHMENTS=
UNKEEP_MAX_DEVICES=
UNKEEP_MAX_SERVICE_CREDENTIALS=
UNKEEP_MAX_MUTATION_RECEIPTS=
UNKEEP_MUTATION_RECEIPT_TTL_MS=

# Incomplete encrypted attachment stages expire after ten minutes of bundle
# inactivity by default. Active stages refresh together; each continuously
# retained stage epoch is capped at one day. Stages count toward record,
# attachment, and byte ceilings.
UNKEEP_ATTACHMENT_STAGE_TTL_MS=

# Optional failed setup/recovery-secret limits. Empty values use a five-minute
# window, five failures per network source, and 100 failures globally.
UNKEEP_ADMIN_RATE_WINDOW_MS=
UNKEEP_ADMIN_SOURCE_RATE_LIMIT=
UNKEEP_ADMIN_GLOBAL_RATE_LIMIT=

# Pairing requests default to ten minutes and cannot exceed one day.
UNKEEP_PAIRING_TTL_MS=

# Legacy compatibility only. Prefer a distinct recovery token and leave unset.
UNKEEP_ALLOW_SETUP_TOKEN_RECOVERY=
